<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <LangVersion>9.0</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>HlslParser</RootNamespace>
        <AssemblyName>HlslParser</AssemblyName>
        <Version>1.0.0</Version>
        <PackageId>HlslParser</PackageId>
        <Description>Standalone HLSL/Cg lexer, preprocessor, parser and syntax tree for shader source, usable on whole files (.hlsl/.cginc/.compute) or on embedded regions within a larger document.</Description>
        <Authors>HlslParser contributors</Authors>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/marek-jelo-jelinek/hlsl-parser</PackageProjectUrl>
        <RepositoryUrl>https://github.com/marek-jelo-jelinek/hlsl-parser</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>Copyright (c) 2026 Marek Jelínek</Copyright>
        <PackageTags>hlsl;cg;unity;shader;parser;lexer;ast</PackageTags>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/</PackageOutputPath>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../../LICENSE" Pack="true" PackagePath=""/>
        <None Include="../../README.md" Pack="true" PackagePath=""/>
    </ItemGroup>
</Project>
